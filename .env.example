# Everything has a sensible default; set only what you need.

# "ollama" runs locally for free; "openai" works with any OpenAI-compatible API (OpenAI, Groq, Together...)
LLM_PROVIDER=ollama
CHAT_MODEL=qwen2.5:7b
OLLAMA_URL=http://localhost:11434
# Model context window in tokens; lower uses less memory
OLLAMA_NUM_CTX=4096
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=...

# Date the agent treats as "today" (defaults to the real date; the eval pins 2026-11-17)
# AGENT_TODAY=2026-11-17

# Safety limit on agent loop iterations
AGENT_MAX_STEPS=12
